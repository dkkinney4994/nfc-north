name: Update league data

on:
  schedule:
    # 10:00 UTC Wednesdays — a few hours after Sleeper's Wednesday 3am waiver clear.
    # Adjust the cron below if your timezone or waiver day differs.
    - cron: "0 10 * * 3"
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Run update script
        run: python scripts/update_data.py

      - name: Commit changes if any
        run: |
          git config user.name "league-data-bot"
          git config user.email "actions@github.com"
          git add data.json
          git diff --cached --quiet || git commit -m "Auto-update league data"
          git push
